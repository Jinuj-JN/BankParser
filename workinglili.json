{
  "name": "Lili Bank Statement",
  "strategy": "regex_rows",
  "fields": {
    "accountNumber": "Account Number Statement Period\\s*([\\d]{12})",
    "period": "[\\d]{12}\\s+(([\\d]{1,2} [A-Za-z]+, \\d{4}) - ([\\d]{1,2} [A-Za-z]+, \\d{4}))",
    "startBalance": "Beginning balance on [\\w\\s,-]+ (\\$[\\d,]+\\.\\d{2})",
    "endBalance": "Ending balance on [\\w\\s,-]+ (\\$[\\d,]+\\.\\d{2})"
  },
  "transactionRegex": "(\\d{2}/\\d{2}/\\d{4})\\s+[\\d]+\\s+(.+?)\\s+(\\$-?[\\d,]+\\.\\d{2})\\s+\\$[\\d,]+\\.\\d{2}"
}